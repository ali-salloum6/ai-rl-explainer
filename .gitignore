# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.venv/
.venv
venv/
ENV/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Manim / LaTeX
latex_cache/

# Rendered video outputs (large); keep empty dir with .gitkeep if needed
media/output/**
!media/output/.gitkeep

# Narration / VO (large; place files per config/audio_manifest.json)
media/audio/**
!media/audio/.gitkeep
!media/audio/raw/
!media/audio/raw/.gitkeep

# Silent Manim previews at media root (regenerated by manimgl)
media/*.mp4
# Content-hashed hero rasters written by our_scenes/kit.py
media/*.png

# FFmpeg concat temp (assemble_final.py)
._narration_concat.mp4
**/._narration_concat.mp4

# Local secrets
.env
.env.*
config/adobe_enhance_auth.json
config/adobe_enhance_token.txt

# Local tooling / fake TeXLive wrappers
.local/

# Upstream Manim / lesson clones — install per README or attach as submodules
# (/manim without a trailing slash also matches manim as a symlink to a sibling checkout)
/manim
videos/

# Tests / packaging
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
*.egg-info/
dist/
build/

# Frame-check screenshots (local verification only)
media/frame_check/
# Per-segment review keyframes (scripts/export_keyframes.py)
keyframes/
# Raw thumbnail stills (our_scenes/thumbnail.py); the finished files are docs/youtube/thumbnails/
media/thumbnails/
# Each segment's last frame (scripts/render_segments.py), the next segment opens on it
media/frames/
# Narration timing logs written by the scenes
media/timing/
